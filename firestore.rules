rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Each signed-in user's full app data (private).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public, unguessable-token-protected calendar feed documents. Anyone who
    // has the link can read (that's how phone calendar apps fetch it without
    // signing in) but only the owning account can create/update/delete its
    // own feed doc, and never claim someone else's uid.
    match /feeds/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
